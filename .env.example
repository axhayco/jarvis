# JARVIS — environment configuration file
# ===================================================================
# Create a file named `.env.local` in the project root directory and add:
#
# GEMINI_API_KEY=your_gemini_api_key_here
#
# Get your free key from Google AI Studio: https://aistudio.google.com/

# ===================================================================
# BRIDGE (the server) — read from .env.local or environment
# ===================================================================

# Google Gemini API key (REQUIRED)
GEMINI_API_KEY=

# Model to run. Default gemini-2.5-flash
# JARVIS_MODEL=gemini-2.5-flash

# Port the bridge listens on (WebSocket + HTTP endpoints). Default 8787.
# JARVIS_BRIDGE_PORT=8787

# Allow effectful tools (send, tap, delete, install, pay). Off by default.
# JARVIS_ALLOW_WRITES=0

# ElevenLabs API key (Optional for premium voice & Scribe transcription)
# ELEVENLABS_API_KEY=
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ===================================================================
# FRONTEND (Vite) — read from .env.local
# ===================================================================

# Which backend the browser talks to. Default bridge.
# VITE_BACKEND=bridge

# Where the bridge listens. Keep port in step with JARVIS_BRIDGE_PORT above.
# VITE_BRIDGE_URL=ws://localhost:8787

# Browser text-to-speech engine. Default system.
# VITE_TTS_ENGINE=system
# VITE_KOKORO_VOICE=bm_george
